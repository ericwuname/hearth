# Hearth CLI/Service 环境变量模板
# 用法：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会进版本库）
#   cp .env.example .env
#   nano .env   # 填入你的 key
#
# D-106（2026-10-02）：**CLI 与 service 都会自动加载本文件**（`dotenvy`，从 cwd 向上查找）。
# 已存在的进程环境变量**优先**（不会被本文件覆盖）；参数（如 --provider/--key）优先级最高。

# ── D-117：CLI 与 service 都认这些「provider 惯例 env」名字（`<PROVIDER>_API_KEY` /
#    `_BASE_URL` / `_MODEL`；可用通道：DEEPSEEK / OPENAI / GEMINI / AGNES / OLLAMA / VLLM）。
#    优先级：命令行参数 > HEARTH_* > <PROVIDER>_* > config.toml。
#    注意：**默认 provider 是 deepseek**——你配了哪个通道，就把 HEARTH_PROVIDER 指到它，
#    否则 CLI 会去找 DEEPSEEK_API_KEY 而报「未配置 API key」。示例（下面任选其一）：
#      HEARTH_PROVIDER=agnes     # 配合 AGNES_API_KEY=...
#      HEARTH_PROVIDER=deepseek  # 配合 DEEPSEEK_API_KEY=...

# ── 主力 LLM：DeepSeek（provider 默认值=deepseek；可用 --provider/`config set provider` 切换）──
DEEPSEEK_API_KEY=sk-your-real-deepseek-key
# 模型默认 deepseek-v4-flash；可改 deepseek-v4-pro / doubao-seed-2-0-code-preview 等
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── OpenAI（**service 的启动硬前置**：不设 OPENAI_API_KEY 时 service 拒绝启动，
#    见 docs/configuration.md「LLM Provider」节；CLI 直跑不需要它）──
OPENAI_API_KEY=sk-your-openai-key-if-needed
OPENAI_MODEL=gpt-4o

# ── 可选：本机 Ollama（不填则 service 跳过 ollama provider）──
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qiyuan-8b:latest

# ── 可选：vLLM ──
# VLLM_BASE_URL=
# VLLM_MODEL=mistral-7b

# ── 成本治理（D-46，2026-10-01 接通真实成本）──
# 预算（USD）。设了 >0 的值才会启用「成本守卫」（subconscious CostGuard：
#   成本 > 预算 80% → Simplify；> 95% → Simplify/交回）。不设 = 不拦（既有语义）。
# HEARTH_COST_BUDGET_USD=1.0
#
# 价格表（USD / 1M tokens）。内置表只含 DeepSeek 官方公开价快照（2026-10-01，
#   https://api-docs.deepseek.com/quick_start/pricing/ ，取高峰价）；
#   **价格会变**，且本项目默认 provider 常不是 DeepSeek → 请按需覆盖。
# 覆盖方式二选一（JSON 结构：{"prices":{"provider/model":{"input_per_1m_usd":..,"output_per_1m_usd":..}},"aliases":{"provider/model":"provider/canonical"}}）
# HEARTH_PRICE_TABLE={"prices":{"deepseek/deepseek-flash":{"input_per_1m_usd":0.30,"output_per_1m_usd":1.20}}}
# HEARTH_PRICE_FILE=./pricing.json
# 注意：若某个用到的 model 查不到价，成本会显式报「不可用」（一条 WARN），
#   而不是按 0 冒充——此时 CostGuard 不会触发。这是有意的「不编造」语义。

# ── Service 监听（CLI 默认连 http://localhost:3000）──
# CODEX_URL=http://localhost:3000
# 日志级别：info / debug
RUST_LOG=info
