     "args": {
      "content": "pub struct User { pub name: String, pub age: u8 }\npub fn format_user(user: &User) -> String { format!(\"{} ({})\", user.name, user.age) }\npub fn greet(users: &[User]) -> Vec<String> { users.iter().map(format_user).collect() }\npub fn to_json(users: &[User]) -> String {\n    let mut json = String::new();\n    json.push('[');\n    \n    for (i, user) in users.iter().enumerate() {\n        if i > 0 {\n            json.push(',');\n        }\n        \n        json.push('{');\n        json.push_str(\"\\\"name\\\":\\\"\");\n        json.push_str(&user.name);\n        json.push_str(\"\\\",\\\"age\\\":\");\n        json.push_str(&user.age.to_string());\n        json.push('}');\n    }\n    \n    json.push(']');\n    json\n}\n\n#[cfg(test)] mod tests { \n    use super::*;\n    \n    #[test] \n    fn t_greet() { \n        let u = User{name:\"Ali\".into(),age:25}; \n        assert_eq!(greet(&[u])[0], \"Ali (25)\"); \n    }\n    \n    #[test]\n    fn t_to_json() {\n        let user = User { name: \"Ali\".into(), age: 25 };\n        let result = to_json(&[user]);\n        assert_eq!(result, \"[{\\\"name\\\":\\\"Ali\\\",\\\"age\\\":25}]\");\n    }\n    \n    #[test]\n    fn t_to_json_multiple_users() {\n        let users = [\n            User { name: \"Ali\".into(), age: 25 },\n            User { name: \"Bob\".into(), age: 30 }\n        ];\n        let result = to_json(&users);\n        assert_eq!(result, \"[{\\\"name\\\":\\\"Ali\\\",\\\"age\\\":25},{\\\"name\\\":\\\"Bob\\\",\\\"age\\\":30}]\");\n    }\n    \n    #[test]\n    fn t_to_json_empty() {\n        let users: Vec<User> = Vec::new();\n        let result = to_json(&users);\n        assert_eq!(result, \"[]\");\n    }\n}",
      "path": "src/lib.rs"
     },
